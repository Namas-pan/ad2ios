+
+static int
+tw_connect_ssid(const char *ssid)
+{
+	struct topaz_wlan_bss b;
+	unsigned i, slen;
+
+	if (ssid == NULL) {
+		return EINVAL;
+	}
+	slen = (unsigned)strlen(ssid);
+	if (slen == 0 || slen > 32) {
+		return EINVAL;
+	}
+	if (!topaz_wlan_ready()) {
+		return ENXIO;
+	}
+	for (i = 0; topaz_wlan_heard(i, &b); i++) {
+		if (b.ssid_length == slen && memcmp(b.ssid, ssid, slen) == 0) {
+			int err = topaz_wlan_connect_bss(i);
+
+			printf("SWEET WLAN: sysctl connect '%s' idx %u -> %d\n",
+			    ssid, i, err);
+			return err;
+		}
+	}
+	printf("SWEET WLAN: sysctl connect '%s' not in BSS list\n", ssid);
+	return ENOENT;
+}
+
+static char tw_sys_connect_ssid[33];
+static int tw_sys_psk_set;
+
+static int
+sysctl_tw_connect SYSCTL_HANDLER_ARGS
+{
+	char ssid[33];
+	int error;
+
+	strlcpy(ssid, tw_sys_connect_ssid, sizeof(ssid));
+	error = sysctl_handle_string(oidp, ssid, sizeof(ssid), req);
+	if (error != 0 || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	strlcpy(tw_sys_connect_ssid, ssid, sizeof(tw_sys_connect_ssid));
+	error = tw_connect_ssid(ssid);
+	return error;
+}
+
+static int
+sysctl_tw_psk SYSCTL_HANDLER_ARGS
+{
+	char buf[64];
+	int error;
+
+	/* Never echo the secret; only "set" / empty on read. */
+	if (req->newptr == USER_ADDR_NULL) {
+		strlcpy(buf, tw_sys_psk_set ? "set" : "", sizeof(buf));
+		return sysctl_handle_string(oidp, buf, sizeof(buf), req);
+	}
+	bzero(buf, sizeof(buf));
+	error = sysctl_handle_string(oidp, buf, sizeof(buf), req);
+	if (error != 0) {
+		return error;
+	}
+	error = topaz_wlan_set_psk(buf);
+	if (error == 0) {
+		tw_sys_psk_set = (buf[0] != '\0');
+		printf("SWEET WLAN: sysctl psk %s\n",
+		    tw_sys_psk_set ? "set" : "cleared");
+	}
+	return error;
+}
