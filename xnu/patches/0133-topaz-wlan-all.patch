+		return;
+	}
+	counters->tx_drops = tw_tx_drops;
+	counters->rx_drops = tw_rx_drops;
+	counters->dhcp_state = (int)tw_dhcp_state;
+	counters->dhcp_tries = tw_dhcp_tries;
+	counters->ip = tw_cfg_ip;
+	counters->mask = tw_cfg_mask;
+	counters->gw = tw_cfg_gw;
+}
+
+void
+topaz_wlan_if_poll(uint32_t ms)
+{
+	uint8_t msg;
+
+	if (!tw_attached) {
+		return;
+	}
+	tw_dhcp_now_ms = ms;
+
+	/* T1: begin renew while address stays up. */
+	if (tw_dhcp_state == TW_DHCP_DONE && tw_dhcp_t1_ms != 0 &&
+	    ms >= tw_dhcp_t1_ms) {
+		tw_dhcp_state = TW_DHCP_RENEW;
+		tw_dhcp_tries = 1;
+		tw_dhcp_last_ms = 0;
+		tw_dhcp_xid ^= ms | 1u;
+		printf("SWEET WLAN: DHCP T1 renew\n");
+		tw_dhcp_send(DHCPREQUEST);
+		return;
+	}
+
+	/* A failed discover run is retried on a timer, not only on reassoc. */
+	if (tw_dhcp_state == TW_DHCP_IDLE && tw_dhcp_restart_ms != 0 &&
+	    (int32_t)(ms - tw_dhcp_restart_ms) >= 0) {
+		tw_dhcp_restart_ms = 0;
+		if (topaz_wlan_authorized()) {
+			printf("SWEET WLAN: DHCP retry cycle\n");
+			tw_dhcp_start(ms);
+			return;
+		}
+	}
+
+	if (tw_dhcp_state != TW_DHCP_DISCOVER && tw_dhcp_state != TW_DHCP_REQUEST &&
+	    tw_dhcp_state != TW_DHCP_RENEW) {
+		return;
+	}
+	if (tw_dhcp_last_ms == 0) {
+		tw_dhcp_last_ms = ms;
+		return;
+	}
+	if (ms - tw_dhcp_last_ms < DHCP_RETRANS_MS) {
+		return;
+	}
+	if (tw_dhcp_tries >= 12) {
+		if (tw_dhcp_state == TW_DHCP_RENEW) {
+			printf("SWEET WLAN: DHCP renew gave up; keeping address\n");
+			tw_dhcp_arm_lease(ms, tw_dhcp_lease_sec != 0 ?
+			    tw_dhcp_lease_sec : DHCP_DEFAULT_LEASE_SEC);
+			return;
+		}
+		printf("SWEET WLAN: DHCP gave up after %u tries; retry in 20 s\n",
+		    tw_dhcp_tries);
+		tw_dhcp_state = TW_DHCP_IDLE;
+		tw_dhcp_tries = 0;
+		/* Without this the interface stayed address-less until a
+		 * reassociation; a flaky DHCP server must not be terminal. */
+		tw_dhcp_restart_ms = ms + 20000;
+		return;
+	}
+	msg = (tw_dhcp_state == TW_DHCP_DISCOVER) ? DHCPDISCOVER : DHCPREQUEST;
+	tw_dhcp_tries++;
+	tw_dhcp_last_ms = ms;
+	tw_dhcp_send(msg);
+}
