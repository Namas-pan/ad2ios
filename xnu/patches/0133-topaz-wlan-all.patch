+static int
+tw_parse_ipv4(const char *s, uint32_t *host_order)
+{
+	unsigned a = 0, b = 0, c = 0, d = 0, n = 0, v = 0;
+	const char *p;
+
+	if (s == NULL || s[0] == '\0') {
+		return -1;
+	}
+	for (p = s; ; p++) {
+		if (*p >= '0' && *p <= '9') {
+			v = v * 10 + (unsigned)(*p - '0');
+			if (v > 255) {
+				return -1;
+			}
+			continue;
+		}
+		if (*p == '.' || *p == '\0') {
+			if (n == 0) {
+				a = v;
+			} else if (n == 1) {
+				b = v;
+			} else if (n == 2) {
+				c = v;
+			} else if (n == 3) {
+				d = v;
+			} else {
+				return -1;
+			}
+			n++;
+			v = 0;
+			if (*p == '\0') {
+				break;
+			}
+			continue;
+		}
+		return -1;
+	}
+	if (n != 4) {
+		return -1;
+	}
+	*host_order = (a << 24) | (b << 16) | (c << 8) | d;
+	return 0;
+}
+
+static uint16_t
+tw_ip_cksum(const void *data, unsigned len)
+{
+	const uint16_t *w = (const uint16_t *)data;
+	uint32_t sum = 0;
+
+	while (len > 1) {
+		sum += ntohs(*w++);
+		len -= 2;
+	}
+	if (len != 0) {
+		sum += *(const uint8_t *)w << 8;
+	}
+	while (sum >> 16) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	return htons((uint16_t)~sum);
+}
+
+/* Announce SPA=TPA=ip so switches/APs refresh the STA MAC (RFC 5227-ish). */
+static void
+tw_garp(uint32_t ip)
+{
+	uint8_t frame[14 + 28];
+	uint8_t mac[6];
+	uint8_t *arp;
+	int on = 1;
+	uint32_t nip;
+
+	if (ip == 0 || !topaz_wlan_authorized()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("wifigarpon", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	topaz_wlan_address(mac);
+	bzero(frame, sizeof(frame));
+	memset(frame, 0xff, 6);
+	memcpy(frame + 6, mac, 6);
+	frame[12] = 0x08;
+	frame[13] = 0x06;
+	arp = frame + 14;
+	arp[0] = 0x00;
+	arp[1] = 0x01; /* Ethernet */
+	arp[2] = 0x08;
+	arp[3] = 0x00; /* IPv4 */
+	arp[4] = 6;
+	arp[5] = 4;
+	arp[6] = 0x00;
+	arp[7] = 0x01; /* request */
+	memcpy(arp + 8, mac, 6);
+	nip = htonl(ip);
+	memcpy(arp + 14, &nip, 4);
+	/* tha = zeros; tpa = same as spa */
+	memcpy(arp + 24, &nip, 4);
+	if (!topaz_wlan_tx_ethernet(frame, sizeof(frame))) {
+		printf("SWEET WLAN: GARP TX failed\n");
+		return;
+	}
+	printf("SWEET WLAN: GARP %u.%u.%u.%u\n",
+	    (ip >> 24) & 0xff, (ip >> 16) & 0xff, (ip >> 8) & 0xff, ip & 0xff);
+}
+
+static void
+tw_apply_ipv4(uint32_t ip, uint32_t mask, uint32_t gw)
+{
+	errno_t err;
+	socket_t so = NULL;
+	struct ifaliasreq ifra;
+	struct sockaddr_in *sin;
+
+	if (!tw_attached || tw_ifp == NULL || tw_addr_done || ip == 0) {
+		return;
+	}
+	if (mask == 0) {
+		mask = 0xffffff00;
+	}
+
+	err = proto_plumb(PF_INET, tw_ifp);
+	if (err == 0) {
+		err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	}
+	if (err == 0) {
+		bzero(&ifra, sizeof(ifra));
+		snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "tw0");
+		sin = (struct sockaddr_in *)&ifra.ifra_addr;
+		sin->sin_len = sizeof(*sin);
+		sin->sin_family = AF_INET;
+		sin->sin_addr.s_addr = htonl(ip);
+		sin = (struct sockaddr_in *)&ifra.ifra_mask;
+		sin->sin_len = sizeof(*sin);
+		sin->sin_family = AF_INET;
+		sin->sin_addr.s_addr = htonl(mask);
+		sin = (struct sockaddr_in *)&ifra.ifra_broadaddr;
+		sin->sin_len = sizeof(*sin);
+		sin->sin_family = AF_INET;
+		sin->sin_addr.s_addr = htonl(ip | ~mask);
+		err = sock_ioctl(so, SIOCAIFADDR, &ifra);
+	}
+	if (err == 0 && gw != 0) {
+		struct sockaddr_in dst, gwm, msk;
+		struct rtentry *rt = NULL;
+
+		bzero(&dst, sizeof(dst));
+		dst.sin_len = sizeof(dst);
+		dst.sin_family = AF_INET;
+		dst.sin_addr.s_addr = htonl(0);
+		gwm = dst;
+		gwm.sin_addr.s_addr = htonl(gw);
+		msk = dst;
+		(void)rtrequest(RTM_ADD, (struct sockaddr *)&dst,
+		    (struct sockaddr *)&gwm, (struct sockaddr *)&msk,
+		    RTF_UP | RTF_GATEWAY | RTF_STATIC, &rt);
+	}
+	if (so != NULL) {
+		sock_close(so);
+	}
+	ifnet_set_flags(tw_ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	if (err == 0) {
+		tw_addr_done = true;
+		tw_cfg_ip = ip;
+		tw_cfg_mask = mask;
+		tw_cfg_gw = gw;
+		printf("SWEET WLAN: tw0 %u.%u.%u.%u mask %u.%u.%u.%u%s\n",
+		    (ip >> 24) & 0xff, (ip >> 16) & 0xff, (ip >> 8) & 0xff, ip & 0xff,
+		    (mask >> 24) & 0xff, (mask >> 16) & 0xff, (mask >> 8) & 0xff,
+		    mask & 0xff, gw != 0 ? " (+gw)" : "");
+		tw_garp(ip);
+	} else {
+		printf("SWEET WLAN: tw0 SIOCAIFADDR failed err %d\n", err);
+	}
+}
+
+static void
+tw_dhcp_arm_lease(uint32_t now_ms, uint32_t lease_sec)
+{
+	if (lease_sec == 0) {
+		lease_sec = DHCP_DEFAULT_LEASE_SEC;
+	}
+	if (lease_sec < 60) {
+		lease_sec = 60;
+	}
+	tw_dhcp_lease_sec = lease_sec;
+	/* T1 = 50% of lease (RFC 2131) */
+	tw_dhcp_t1_ms = now_ms + (lease_sec / 2) * 1000u;
+	tw_dhcp_state = TW_DHCP_DONE;
+	printf("SWEET WLAN: DHCP lease %u s (renew ~%u s)\n",
+	    lease_sec, lease_sec / 2);
+}
+
+static void
+tw_dhcp_send(uint8_t msgtype)
+{
+	uint8_t frame[14 + 20 + 8 + 300];
+	uint8_t mac[6];
+	uint8_t *ip, *udp, *boot, *opt;
+	unsigned iplen, udplen, bootlen;
+	int renew = (tw_dhcp_state == TW_DHCP_RENEW);
+
+	if (!topaz_wlan_authorized()) {
+		return;
+	}
+	topaz_wlan_address(mac);
+	bzero(frame, sizeof(frame));
+
+	/* L2 broadcast (no ARP for DHCP server MAC yet). */
+	memset(frame, 0xff, 6);
+	memcpy(frame + 6, mac, 6);
+	frame[12] = 0x08;
+	frame[13] = 0x00;
+
+	ip = frame + 14;
+	udp = ip + 20;
+	boot = udp + 8;
+
+	boot[0] = 1; /* BOOTREQUEST */
+	boot[1] = 1; /* Ethernet */
+	boot[2] = 6;
+	boot[3] = 0;
+	boot[4] = (uint8_t)(tw_dhcp_xid >> 24);
+	boot[5] = (uint8_t)(tw_dhcp_xid >> 16);
+	boot[6] = (uint8_t)(tw_dhcp_xid >> 8);
+	boot[7] = (uint8_t)tw_dhcp_xid;
+	if (renew) {
+		uint32_t ci = htonl(tw_dhcp_yiaddr);
+
+		memcpy(boot + 12, &ci, 4); /* ciaddr */
+	} else {
+		boot[10] = 0x80; /* broadcast flag */
+	}
+	memcpy(boot + 28, mac, 6);
+	/* options at offset 236 */
+	opt = boot + 236;
+	opt[0] = 99;
+	opt[1] = 130;
+	opt[2] = 83;
+	opt[3] = 99;
+	opt += 4;
+	*opt++ = DHCP_OPT_MSG;
+	*opt++ = 1;
+	*opt++ = msgtype;
+	if (msgtype == DHCPREQUEST && !renew) {
+		uint32_t yi = htonl(tw_dhcp_yiaddr);
+		uint32_t sid = htonl(tw_dhcp_server);
+
+		*opt++ = DHCP_OPT_REQIP;
+		*opt++ = 4;
+		memcpy(opt, &yi, 4);
+		opt += 4;
+		*opt++ = DHCP_OPT_SERVER;
+		*opt++ = 4;
+		memcpy(opt, &sid, 4);
+		opt += 4;
+	}
+	*opt++ = 55; /* parameter request list */
+	*opt++ = 4;
+	*opt++ = DHCP_OPT_MASK;
+	*opt++ = DHCP_OPT_ROUTER;
+	*opt++ = DHCP_OPT_DNS;
+	*opt++ = DHCP_OPT_LEASE;
+	*opt++ = DHCP_OPT_END;
+	bootlen = (unsigned)(opt - boot);
+	if (bootlen < 300) {
+		bootlen = 300;
+	}
+
+	udplen = 8 + bootlen;
+	udp[0] = 0;
+	udp[1] = 68;
+	udp[2] = 0;
+	udp[3] = 67;
+	udp[4] = (uint8_t)(udplen >> 8);
+	udp[5] = (uint8_t)udplen;
+	udp[6] = 0;
+	udp[7] = 0; /* UDP checksum optional */
+
+	iplen = 20 + udplen;
+	ip[0] = 0x45;
+	ip[2] = (uint8_t)(iplen >> 8);
+	ip[3] = (uint8_t)iplen;
+	ip[8] = 64;
+	ip[9] = IPPROTO_UDP;
+	if (renew && tw_dhcp_yiaddr != 0) {
+		uint32_t src = htonl(tw_dhcp_yiaddr);
+		uint32_t dst = tw_dhcp_server != 0 ? htonl(tw_dhcp_server) :
+		    0xffffffffu;
+
+		memcpy(ip + 12, &src, 4);
+		memcpy(ip + 16, &dst, 4);
+	} else {
+		/* src 0.0.0.0 dst 255.255.255.255 */
+		ip[16] = ip[17] = ip[18] = ip[19] = 0xff;
+	}
+	ip[10] = ip[11] = 0;
+	{
+		uint16_t csum = tw_ip_cksum(ip, 20);
+
+		memcpy(ip + 10, &csum, 2);
+	}
+
+	if (!topaz_wlan_tx_ethernet(frame, 14 + iplen)) {
+		printf("SWEET WLAN: DHCP %s TX failed\n",
+		    msgtype == DHCPDISCOVER ? "DISCOVER" :
+		    (renew ? "RENEW" : "REQUEST"));
+		return;
+	}
+	printf("SWEET WLAN: DHCP %s sent (try %u)\n",
+	    msgtype == DHCPDISCOVER ? "DISCOVER" :
+	    (renew ? "RENEW" : "REQUEST"), tw_dhcp_tries);
+}
+
+static void
+tw_dhcp_parse_options(const uint8_t *opt, unsigned len, uint8_t *msg,
+    uint32_t *mask, uint32_t *gw, uint32_t *server, uint32_t *lease,
+    uint32_t *dns)
+{
+	unsigned i = 0;
+
+	*msg = 0;
+	while (i + 1 < len) {
+		uint8_t code = opt[i++];
+		uint8_t olen;
+
+		if (code == DHCP_OPT_END) {
+			break;
+		}
+		if (code == 0) {
+			continue;
+		}
+		if (i >= len) {
+			break;
+		}
+		olen = opt[i++];
+		if (i + olen > len) {
+			break;
+		}
+		if (code == DHCP_OPT_MSG && olen >= 1) {
+			*msg = opt[i];
+		} else if (code == DHCP_OPT_MASK && olen >= 4) {
+			*mask = (opt[i] << 24) | (opt[i + 1] << 16) |
+			    (opt[i + 2] << 8) | opt[i + 3];
+		} else if (code == DHCP_OPT_ROUTER && olen >= 4) {
+			*gw = (opt[i] << 24) | (opt[i + 1] << 16) |
+			    (opt[i + 2] << 8) | opt[i + 3];
+		} else if (code == DHCP_OPT_SERVER && olen >= 4) {
+			*server = (opt[i] << 24) | (opt[i + 1] << 16) |
+			    (opt[i + 2] << 8) | opt[i + 3];
+		} else if (code == DHCP_OPT_LEASE && olen >= 4) {
+			*lease = (opt[i] << 24) | (opt[i + 1] << 16) |
+			    (opt[i + 2] << 8) | opt[i + 3];
+		} else if (code == DHCP_OPT_DNS && olen >= 4 && dns != NULL) {
+			*dns = (opt[i] << 24) | (opt[i + 1] << 16) |
+			    (opt[i + 2] << 8) | opt[i + 3];
+		}
+		i += olen;
+	}
+}
+
+/* Returns true if the frame was a DHCP reply we consumed. */
+static bool
+tw_dhcp_rx(const uint8_t *eth, unsigned len)
+{
+	const uint8_t *ip, *udp, *boot, *opt;
+	unsigned iplen, udplen;
+	uint32_t xid, yiaddr, mask = 0xffffff00, gw = 0, server = 0;
+	uint32_t lease = 0, dns = 0;
+	uint8_t msg = 0;
+
+	if (tw_dhcp_state != TW_DHCP_DISCOVER && tw_dhcp_state != TW_DHCP_REQUEST &&
+	    tw_dhcp_state != TW_DHCP_RENEW) {
+		return false;
+	}
+	if (len < 14 + 20 + 8 + 240) {
+		return false;
+	}
+	if (eth[12] != 0x08 || eth[13] != 0x00) {
+		return false;
+	}
+	ip = eth + 14;
+	if ((ip[0] & 0xf0) != 0x40 || ip[9] != IPPROTO_UDP) {
+		return false;
+	}
+	iplen = ((unsigned)ip[0] & 0x0f) * 4;
+	if (len < 14 + iplen + 8) {
+		return false;
+	}
+	udp = ip + iplen;
+	if (udp[2] != 0 || udp[3] != 68) { /* dport 68 */
+		return false;
+	}
+	udplen = ((unsigned)udp[4] << 8) | udp[5];
+	if (udplen < 8 + 240 || 14 + iplen + udplen > len) {
+		return false;
+	}
+	boot = udp + 8;
+	if (boot[0] != 2) { /* BOOTREPLY */
+		return false;
+	}
+	xid = ((uint32_t)boot[4] << 24) | ((uint32_t)boot[5] << 16) |
+	    ((uint32_t)boot[6] << 8) | boot[7];
+	if (xid != tw_dhcp_xid) {
+		return false;
+	}
+	yiaddr = ((uint32_t)boot[16] << 24) | ((uint32_t)boot[17] << 16) |
+	    ((uint32_t)boot[18] << 8) | boot[19];
+	opt = boot + 236;
+	if (opt[0] != 99 || opt[1] != 130 || opt[2] != 83 || opt[3] != 99) {
+		return false;
+	}
+	tw_dhcp_parse_options(opt + 4, udplen - 8 - 240, &msg, &mask, &gw,
+	    &server, &lease, &dns);
+
+	if (msg == DHCPOFFER && tw_dhcp_state == TW_DHCP_DISCOVER) {
+		tw_dhcp_yiaddr = yiaddr;
+		tw_dhcp_server = server != 0 ? server :
+		    ((uint32_t)ip[12] << 24) | ((uint32_t)ip[13] << 16) |
+		    ((uint32_t)ip[14] << 8) | ip[15];
+		tw_dhcp_mask = mask;
+		tw_dhcp_gw = gw;
+		tw_dhcp_state = TW_DHCP_REQUEST;
+		tw_dhcp_last_ms = 0;
+		printf("SWEET WLAN: DHCP OFFER %u.%u.%u.%u from %u.%u.%u.%u\n",
+		    (yiaddr >> 24) & 0xff, (yiaddr >> 16) & 0xff,
+		    (yiaddr >> 8) & 0xff, yiaddr & 0xff,
+		    (tw_dhcp_server >> 24) & 0xff, (tw_dhcp_server >> 16) & 0xff,
+		    (tw_dhcp_server >> 8) & 0xff, tw_dhcp_server & 0xff);
+		tw_dhcp_tries = 1;
+		tw_dhcp_send(DHCPREQUEST);
+		return true;
+	}
+	if (msg == DHCPACK && (tw_dhcp_state == TW_DHCP_REQUEST ||
+	    tw_dhcp_state == TW_DHCP_RENEW)) {
+		uint32_t now = tw_dhcp_now_ms != 0 ? tw_dhcp_now_ms :
+		    (tw_dhcp_last_ms != 0 ? tw_dhcp_last_ms : 1);
+
+		if (server != 0) {
+			tw_dhcp_server = server;
+		}
+		if (mask == 0xffffff00 && tw_dhcp_mask != 0) {
+			mask = tw_dhcp_mask;
+		}
+		if (gw == 0) {
+			gw = tw_dhcp_gw;
+		}
+		printf("SWEET WLAN: DHCP ACK %u.%u.%u.%u%s\n",
+		    (yiaddr >> 24) & 0xff, (yiaddr >> 16) & 0xff,
+		    (yiaddr >> 8) & 0xff, yiaddr & 0xff,
+		    tw_dhcp_state == TW_DHCP_RENEW ? " (renew)" : "");
+		if (dns != 0) {
+			tw_cfg_dns = dns;
+			printf("SWEET WLAN: DHCP DNS %u.%u.%u.%u (stored; not resolv)\n",
+			    (dns >> 24) & 0xff, (dns >> 16) & 0xff,
+			    (dns >> 8) & 0xff, dns & 0xff);
+		}
+		if (!tw_addr_done) {
+			tw_apply_ipv4(yiaddr, mask != 0 ? mask : tw_dhcp_mask, gw);
+		} else if (gw != 0) {
+			tw_cfg_gw = gw;
+		}
+		tw_dhcp_yiaddr = yiaddr;
+		tw_dhcp_arm_lease(now, lease);
+		return true;
+	}
+	if (msg == DHCPNAK && (tw_dhcp_state == TW_DHCP_REQUEST ||
+	    tw_dhcp_state == TW_DHCP_RENEW)) {
+		printf("SWEET WLAN: DHCP NAK, restarting DISCOVER\n");
+		tw_dhcp_t1_ms = 0;
+		tw_dhcp_state = TW_DHCP_IDLE;
+		tw_addr_done = false;
+		tw_cfg_ip = tw_cfg_mask = tw_cfg_gw = tw_cfg_dns = 0;
+		tw_dhcp_start(tw_dhcp_last_ms);
+		return true;
+	}
+	return false;
+}
+
+static void
+tw_dhcp_start(uint32_t ms)
+{
+	uint8_t mac[6];
+
+	if (tw_addr_done || tw_dhcp_state == TW_DHCP_DONE) {
+		return;
+	}
+	topaz_wlan_address(mac);
+	tw_dhcp_xid = ((uint32_t)mac[2] << 24) | ((uint32_t)mac[3] << 16) |
+	    ((uint32_t)mac[4] << 8) | mac[5];
+	tw_dhcp_xid ^= ms;
+	if (tw_dhcp_xid == 0) {
+		tw_dhcp_xid = 0x544f5030; /* 'TOP0' */
+	}
+	tw_dhcp_state = TW_DHCP_DISCOVER;
+	tw_dhcp_tries = 1;
+	tw_dhcp_last_ms = 0; /* next poll() arms the retransmit timer */
+	tw_dhcp_server = tw_dhcp_yiaddr = tw_dhcp_gw = 0;
+	tw_dhcp_mask = 0xffffff00;
+	printf("SWEET WLAN: DHCP starting\n");
+	tw_dhcp_send(DHCPDISCOVER);
+}
+
+static void
+tw_configure_ipv4(void)
+{
+	char ipstr[32], maskstr[32], gwstr[32], dnsstr[32];
+	uint32_t ip = 0, mask = 0xffffff00, gw = 0, dns = 0;
+	int want_dhcp = 0;
+
+	if (!tw_attached || tw_ifp == NULL || tw_addr_done) {
+		return;
+	}
+	(void)PE_parse_boot_argn("wifidhcp", &want_dhcp, sizeof(want_dhcp));
+	if (PE_parse_boot_argn("wifiip", ipstr, sizeof(ipstr)) && ipstr[0] != '\0') {
+		if (strcmp(ipstr, "dhcp") == 0) {
+			want_dhcp = 1;
+		} else if (tw_parse_ipv4(ipstr, &ip) == 0) {
+			want_dhcp = 0;
+		} else {
+			printf("SWEET WLAN: bad wifiip='%s'\n", ipstr);
+			return;
+		}
+	}
+	if (want_dhcp) {
+		tw_dhcp_start(0);
+		return;
+	}
+	if (ip == 0) {
+		printf("SWEET WLAN: no wifiip= (tw0 link only; wifiip=dhcp for DHCP)\n");
+		return;
+	}
+	if (PE_parse_boot_argn("wifimask", maskstr, sizeof(maskstr)) &&
+	    maskstr[0] != '\0') {
+		if (tw_parse_ipv4(maskstr, &mask) != 0) {
+			printf("SWEET WLAN: bad wifimask='%s'\n", maskstr);
+			return;
+		}
+	}
+	if (PE_parse_boot_argn("wifigw", gwstr, sizeof(gwstr)) &&
+	    gwstr[0] != '\0') {
+		if (tw_parse_ipv4(gwstr, &gw) != 0) {
+			printf("SWEET WLAN: bad wifigw='%s'\n", gwstr);
+			gw = 0;
+		}
+	}
+	if (PE_parse_boot_argn("wifidns", dnsstr, sizeof(dnsstr)) &&
+	    dnsstr[0] != '\0') {
+		if (tw_parse_ipv4(dnsstr, &dns) != 0) {
+			printf("SWEET WLAN: bad wifidns='%s'\n", dnsstr);
+			dns = 0;
+		}
+	}
+	tw_apply_ipv4(ip, mask, gw);
+	if (tw_addr_done && dns != 0) {
+		tw_cfg_dns = dns;
+		printf("SWEET WLAN: DNS %u.%u.%u.%u (wifidns=; not resolv)\n",
+		    (dns >> 24) & 0xff, (dns >> 16) & 0xff,
+		    (dns >> 8) & 0xff, dns & 0xff);
+	}
+}
 
