+	topaz_wlan_if_stats(&c);
+	snprintf(buf, sizeof(buf), "tx_drops=%u rx_drops=%u dhcp=%d tries=%u\n",
+	    c.tx_drops, c.rx_drops, c.dhcp_state, c.dhcp_tries);
+	return sysctl_handle_string(oidp, buf, sizeof(buf), req);
+}
