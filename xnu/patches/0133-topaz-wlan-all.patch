+static int
+rtc_read_raw_word(uint32_t *secs)
+{
+	uint8_t b[4];
+
+	if (rtc_spmi_read(RTC_READ + 0, &b[0]) ||
+	    rtc_spmi_read(RTC_READ + 1, &b[1]) ||
+	    rtc_spmi_read(RTC_READ + 2, &b[2]) ||
+	    rtc_spmi_read(RTC_READ + 3, &b[3])) {
+		return -1;
+	}
+	*secs = (uint32_t)b[0] | ((uint32_t)b[1] << 8) |
+	    ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
+	return 0;
+}
+
+/*
+ * The counter is fetched one byte at a time over SPMI, so a carry that lands
+ * between two byte reads tears the word (e.g. 0x00ff01 -> 0x00ff02 read as
+ * 0x00ff01 and 0x000002). Two matching full reads prove the sample stable;
+ * on a mismatch a third read is taken because a byte-level comparison of the
+ * low byte (the old check) misses carries into b1..b3 entirely.
+ */
 static int
 rtc_read_raw(uint32_t *secs)
 {
-	uint8_t b0, b1, b2, b3, b0b;
+	uint32_t first = 0, second = 0;
 
-	if (rtc_spmi_read(RTC_READ + 0, &b0) ||
-	    rtc_spmi_read(RTC_READ + 1, &b1) ||
-	    rtc_spmi_read(RTC_READ + 2, &b2) ||
-	    rtc_spmi_read(RTC_READ + 3, &b3) ||
-	    rtc_spmi_read(RTC_READ + 0, &b0b)) {
+	if (rtc_read_raw_word(&first) || rtc_read_raw_word(&second)) {
 		return -1;
 	}
-	if (b0b < b0) {
-		if (rtc_spmi_read(RTC_READ + 0, &b0) ||
-		    rtc_spmi_read(RTC_READ + 1, &b1) ||
-		    rtc_spmi_read(RTC_READ + 2, &b2) ||
-		    rtc_spmi_read(RTC_READ + 3, &b3)) {
-			return -1;
-		}
+	if (first != second && rtc_read_raw_word(&second)) {
+		return -1;
 	}
-	*secs = (uint32_t)b0 | ((uint32_t)b1 << 8) |
-	    ((uint32_t)b2 << 16) | ((uint32_t)b3 << 24);
+	*secs = second;
 	return 0;
 }
 
