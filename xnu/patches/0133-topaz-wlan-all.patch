+void
+topaz_wlan_if_input(const uint8_t *eth, unsigned len)
+{
+	mbuf_t m = NULL;
+	struct ifnet_stat_increment_param stats;
+
+	if (!tw_attached || tw_ifp == NULL || eth == NULL ||
+	    len < ETHER_HDR_LEN || len > ETHER_MAX_LEN) {
+		return;
+	}
+	if (tw_dhcp_rx(eth, len)) {
+		return;
+	}
+	if (mbuf_allocpacket(MBUF_DONTWAIT, len, NULL, &m) != 0 || m == NULL) {
+		tw_rx_drops++;
+		return;
+	}
+	if (mbuf_copyback(m, 0, len, eth, MBUF_DONTWAIT) != 0) {
+		tw_rx_drops++;
+		mbuf_freem(m);
+		return;
+	}
+	bzero(&stats, sizeof(stats));
+	{
+		void *frame_header = mbuf_data(m);
+
+		mbuf_pkthdr_setrcvif(m, tw_ifp);
+		mbuf_pkthdr_setheader(m, frame_header);
+		mbuf_pkthdr_adjustlen(m, -(int)ETHER_HDR_LEN);
+		(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN,
+		    mbuf_len(m) - ETHER_HDR_LEN);
+	}
+	stats.packets_in = 1;
+	stats.bytes_in = len;
+	ifnet_input(tw_ifp, m, &stats);
+}
+
+void
+topaz_wlan_if_on_authorized(void)
+{
+	if (!tw_attached) {
+		tw_attach_ifnet();
+	}
+	tw_configure_ipv4();
+}
+
+void
+topaz_wlan_if_on_disconnected(void)
+{
+	errno_t err;
+	socket_t so = NULL;
+	struct ifreq ifr;
+
+	tw_dhcp_state = TW_DHCP_IDLE;
+	tw_dhcp_t1_ms = 0;
+	tw_dhcp_last_ms = 0;
+	tw_dhcp_tries = 0;
+	tw_dhcp_restart_ms = 0;
+	tw_cfg_ip = tw_cfg_mask = tw_cfg_gw = tw_cfg_dns = 0;
+	if (!tw_attached || tw_ifp == NULL) {
+		tw_addr_done = false;
+		return;
+	}
+	if (tw_addr_done) {
+		err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+		if (err == 0) {
+			bzero(&ifr, sizeof(ifr));
+			snprintf(ifr.ifr_name, sizeof(ifr.ifr_name), "tw0");
+			(void)sock_ioctl(so, SIOCDIFADDR, &ifr);
+			sock_close(so);
+		}
+		tw_addr_done = false;
+		printf("SWEET WLAN: tw0 addr cleared (disconnect)\n");
+	} else {
+		printf("SWEET WLAN: tw0 link down\n");
+	}
+}
+
+bool
+topaz_wlan_if_ipv4(uint32_t *ip, uint32_t *mask, uint32_t *gw, uint32_t *dns)
+{
+	if (!tw_addr_done || tw_cfg_ip == 0) {
+		return false;
+	}
+	if (ip != NULL) {
+		*ip = tw_cfg_ip;
+	}
+	if (mask != NULL) {
+		*mask = tw_cfg_mask;
+	}
+	if (gw != NULL) {
+		*gw = tw_cfg_gw;
+	}
+	if (dns != NULL) {
+		*dns = tw_cfg_dns;
+	}
+	return true;
+}
