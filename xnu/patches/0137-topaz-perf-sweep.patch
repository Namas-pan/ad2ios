Subject: [PATCH] topaz: per-command latency and idle wakeups outside the display

Four hot paths outside the scanout code still pay costs that only show up once
the phone is interactive:

- UFS waits for a command with a flat 200 us nap after 50 us of spinning, so
  every 4 KiB read - an app launch issues thousands - is delayed by up to that
  nap even when the device answered in 100 us. The poll interval now starts at
  20 us and doubles up to 200 us, which keeps the answer for fast commands and
  still sleeps through slow ones.
- Touch polls every 10 ms whether or not a finger is down: 100 wakeups per
  second on a four-core phone, and 10 ms of avoidable latency while drawing.
  It now polls every 8 ms with a finger down and every 16 ms when idle (the
  IRQ-hint path keeps its ~100 ms idle reads, adjusted for the new tick).
- modem_watch() idled at 4 ms once the link had been quiet for 150 ms; 8 ms
  halves that steady wakeup load without touching the 1 ms cadence that the
  datapath needs while traffic is flowing.
- sweet_log_append()/sweet_log_copy() did one 64-bit modulo per console byte
  for the 4 MiB ring. They now compute the offset once and copy with memcpy,
  including the wrap; the console path runs for every kernel printf and every
  /dev/console write.

Nothing here changes behaviour on the wire; it removes spin/nap and wakeup
costs from input, storage, radio idle and console.

diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index ff9d858..4bb2b64 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -691,7 +691,7 @@ touch_thread(void *arg, wait_result_t result)
 	}
 	st.kind = goodix ? TOUCH_GOODIX : TOUCH_FTS;
 	st.stage = "polling";
-	printf("SWEET TOUCH: selected %s, 1080x2400, poll=10ms irq-hint=%d\n",
+	printf("SWEET TOUCH: selected %s, 1080x2400, poll=8ms down/16ms idle irq-hint=%d\n",
 	    goodix ? "GT9896 Yellowstone" : "Focaltech 54:52", st.irq_hint);
 	unsigned errors = 0, ticks = 0, polls = 0;
 	while (!st.dead) {
@@ -706,7 +706,7 @@ touch_thread(void *arg, wait_result_t result)
 		/* Optional IRQ hint still reads every 100ms, and always while down. */
 		if (!st.irq_hint || st.active ||
 		    !(touch_rd(st.west, TOUCH_GPIO_IO(TOUCH_PIN_IRQ)) & 1u) ||
-		    (++ticks % 10u) == 0) {
+		    (++ticks % 6u) == 0) {
 			int err = st.kind == TOUCH_GOODIX ? touch_goodix() : touch_focaltech();
 			if (err) {
 				st.s_errs++;
@@ -721,7 +721,9 @@ touch_thread(void *arg, wait_result_t result)
 				errors = 0;
 			}
 		}
-		touch_wait(10);
+		/* 8 ms while a finger is down keeps drawing responsive; 16 ms
+		 * when idle halves the wakeups (125 Hz -> 62 Hz). */
+		touch_wait(st.active ? 8 : 16);
 	}
 	touch_report(0, st.x, st.y);
 out:
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 4f443e7..347d4c2 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -77,6 +77,7 @@ extern int sweet_rtc_init(void);
 #define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
 #define CMD_SPIN_NS     (50ull * NSEC_PER_USEC)
 #define CMD_SLEEP_NS    (200ull * NSEC_PER_USEC)
+#define CMD_SLEEP_MIN_NS (20ull * NSEC_PER_USEC)
 
 struct utrd {
 	uint32_t dw0, dw1, dw2, dw3;
@@ -211,11 +212,15 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 	deadline += mach_absolute_time();
 	bool sleepable = su.wait && su.ready && ml_get_interrupts_enabled() &&
 	    !ml_at_interrupt_context() && get_preemption_level() == 0;
-	uint64_t spin_until = 0, sleep_interval = 0;
+	uint64_t spin_until = 0, sleep_interval = 0, sleep_max = 0;
 	if (sleepable) {
 		nanoseconds_to_absolutetime(CMD_SPIN_NS, &spin_until);
 		spin_until += mach_absolute_time();
-		nanoseconds_to_absolutetime(CMD_SLEEP_NS, &sleep_interval);
+		/* Start the sleep short and widen it: a 4 KiB read finishes in
+		 * ~100 us, and a flat 200 us nap added that much to every one
+		 * of the thousands of small reads an app launch issues. */
+		nanoseconds_to_absolutetime(CMD_SLEEP_MIN_NS, &sleep_interval);
+		nanoseconds_to_absolutetime(CMD_SLEEP_NS, &sleep_max);
 	}
 	while (ufs_rd(REG_UTRLDBR) & 1) {
 		uint64_t now = mach_absolute_time();
@@ -231,6 +236,7 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 			    TIMEOUT_URGENCY_SYS_CRITICAL, wake, 0) == THREAD_WAITING) {
 				thread_block(THREAD_CONTINUE_NULL);
 			}
+			sleep_interval = MIN(sleep_interval * 2, sleep_max);
 		} else {
 			delay(1);
 		}
@@ -865,8 +871,14 @@ sweet_log_append(const char *c, int size)
 		return;
 	}
 	uint64_t at = os_atomic_add_orig(&sweet_log_total, (uint64_t)size, relaxed);
-	for (int i = 0; i < size; i++) {
-		sweet_log_ring[(at + (uint64_t)i) % SWEET_LOG_SIZE] = c[i];
+	size_t off = (size_t)(at % SWEET_LOG_SIZE);
+	size_t first = MIN((size_t)size, SWEET_LOG_SIZE - off);
+
+	/* One modulo per call instead of one per byte: this runs for every
+	 * console character from any context, boot included. */
+	memcpy(&sweet_log_ring[off], c, first);
+	if ((size_t)size > first) {
+		memcpy(&sweet_log_ring[0], c + first, (size_t)size - first);
 	}
 }
 
@@ -885,8 +897,12 @@ sweet_log_copy(uint64_t *pos, char *out, uint32_t max)
 		*pos = total - SWEET_LOG_SIZE;
 	}
 	uint32_t n = (uint32_t)MIN((uint64_t)max, total - *pos);
-	for (uint32_t i = 0; i < n; i++) {
-		out[i] = sweet_log_ring[(*pos + i) % SWEET_LOG_SIZE];
+	size_t off = (size_t)(*pos % SWEET_LOG_SIZE);
+	size_t first = MIN((size_t)n, SWEET_LOG_SIZE - off);
+
+	memcpy(out, &sweet_log_ring[off], first);
+	if ((size_t)n > first) {
+		memcpy(out + first, &sweet_log_ring[0], (size_t)n - first);
 	}
 	*pos += n;
 	return n;
diff --git a/iokit/Kernel/arm/TopazModem.cpp b/iokit/Kernel/arm/TopazModem.cpp
index cdcee01..e9ff319 100644
--- a/iokit/Kernel/arm/TopazModem.cpp
+++ b/iokit/Kernel/arm/TopazModem.cpp
@@ -489,7 +489,7 @@ static unsigned g_ms;                           /* watch time, for the log */
  * topazpoll=<ms> overrides the idle cadence (0 or 1 disables the back-off).
  */
 #define POLL_QUIET_MS 150
-static unsigned a_poll_idle_ms = 4;
+static unsigned a_poll_idle_ms = 8;
 static unsigned poll_kick_ms;
 static inline void poll_kick(void) { poll_kick_ms = g_ms; }
 
